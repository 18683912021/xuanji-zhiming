ENVIRONMENT=development
POSTGRES_PASSWORD=dev-only
BACKEND_PORT=8000
WEB_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
COOKIE_SECURE=false
# Optional for local development. When set, the admin account is provisioned on first start.
DEVELOPMENT_ADMIN_PASSWORD=
# Email verification requires an SMTP relay and a random secret of at least 32 characters.
AUTH_CODE_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_SENDER=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURITY=starttls
# Mini Program login. Set the AppSecret in this server environment only.
WECHAT_APP_ID=wx99173f0f5cf30a60
WECHAT_APP_SECRET=
# Host process uses DATABASE_URL. Compose builds its container URL from the DB settings.
# DATABASE_URL=postgresql+psycopg://xuanji:dev-only@127.0.0.1:5432/xuanji
AI_PROVIDER=openai
# AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
AI_EMBEDDING_MODEL=
